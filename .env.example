# SmallRAG target. Run SmallRAG on a port different from this evaluation app.
SMALLRAG_BASE_URL=http://127.0.0.1:8001
SMALLRAG_TOP_K=5
SMALLRAG_ALPHA=0.5
SMALLRAG_TIMEOUT_SECONDS=90
SMALLRAG_VERIFY_SSL=true

# Batch pressure applied by the evaluation system to any target RAG.
TARGET_RAG_MAX_CONCURRENCY=2
TARGET_RAG_TIMEOUT_SECONDS=120

# Evaluation models. Configure these when evaluation-rag runs on the same host.
EVAL_LLM_BASE_URL=http://127.0.0.1:8000
EVAL_LLM_MODEL=qwen3-8b
EVAL_LLM_TIMEOUT_SECONDS=60
EVAL_LLM_VERIFY_SSL=true
EVAL_LLM_MAX_TOKENS=1024
EVAL_LLM_TEMPERATURE=0

EVAL_EMBEDDING_BASE_URL=http://127.0.0.1:8080
EVAL_EMBEDDING_MODEL=qwen3-embedding-0.6b
EVAL_EMBEDDING_TIMEOUT_SECONDS=60
EVAL_EMBEDDING_VERIFY_SSL=true

EVAL_MODEL_MAX_CONCURRENCY=4
EVAL_METRIC_TIMEOUT_SECONDS=60

# Optional gateway authentication and context safety limit.
# SMALLRAG_API_KEY=
# SMALLRAG_MAX_CONTEXT_CHARS=50000
# EVAL_LLM_API_KEY=
# EVAL_EMBEDDING_API_KEY=
